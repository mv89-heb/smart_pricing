# העתק קובץ זה ל-.env למחיקה מקומית, או הגדר את המשתנים ישירות בסביבת הפריסה (למשל Render).
# .env אינו נטען אוטומטית אם לא קיים - בטוח להשאיר את הקובץ הזה כרפרנס בלבד.

# מחרוזת חיבור למסד הנתונים. חסר => נופל חזרה ל-SQLite מקומי (local_products.db).
# בפרודקשן: כתובת Postgres, לדוגמה postgres://user:pass@host:5432/dbname
DATABASE_URL=

# מפתח הצפנת סשן. חובה להגדיר ערך ייחודי ואקראי בפרודקשן - אחרת המערכת תדפיס אזהרה בלוגים.
SECRET_KEY=

# סיסמת המנהל הראשוני שנוצר אוטומטית בעליית שרת ריק. אם לא מוגדר, ברירת המחדל היא password123 -
# מומלץ להגדיר ערך משלך לפני הפריסה הראשונה, או להחליף סיסמה מיד דרך מסך ההגדרות לאחר ההתחברות הראשונה.
ADMIN_BOOTSTRAP_PASSWORD=

# מסמן שהסביבה היא פרודקשן (מפעיל עוגיית סשן מאובטחת ל-HTTPS בלבד). Render מגדיר RENDER=true אוטומטית.
FLASK_ENV=production
